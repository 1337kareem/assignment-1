@startuml activity
title COLORS Web App - Activity Diagram

|User|
start
:Open index.html;
repeat
  |User|
  :Enter username and password;
  :Click "Do It";
  |Browser (code.js)|
  :doLogin(): POST {login, password}
  to /api/Login.php
  (password is sent as plain text);
  |Server (PHP + MySQL)|
  :SELECT ID, firstName, lastName FROM Users
  WHERE Login=? AND Password=?;
  if (Matching row found?) then (yes)
    :Return {id, firstName, lastName, error:""};
  else (no)
    :Return {id:0, firstName:"",
    lastName:"", error:"No Records Found"};
  endif
  |Browser (code.js)|
  if (id < 1?) then (yes)
    :Show "User/Password combination incorrect";
  else (no)
    :saveCookie(): store firstName, lastName and
    userId in one cookie that expires in 20 min;
  endif
repeat while (id < 1?) is (yes) not (no)
:Redirect to color.html;
:readCookie() runs when color.html loads
(DOMContentLoaded);
if (userId found in cookie?) then (no)
  :Redirect to index.html;
  stop
else (yes)
endif
|User|
while (Click "Log Out"?) is (no)
  if (Search for a color?) then (yes)
    :Type in "Color To Search For",
    click "Search Color";
    |Browser (code.js)|
    :searchColor(): POST {search, userId}
    to /api/SearchColors.php;
    |Server (PHP + MySQL)|
    :SELECT Name FROM Colors
    WHERE Name LIKE %search% AND UserID=?;
    if (Any matches?) then (yes)
      :Return {results:[names], error:""};
    else (no)
      :Return {id:0, firstName:"",
      lastName:"", error:"No Records Found"};
    endif
    |Browser (code.js)|
    :Show "Color(s) has been retrieved";
    if (Response has results?) then (yes)
      :Show matching colors in colorList;
    else (no)
      :Reading results.length throws a TypeError,
      so colorList is not updated;
    endif
  else (no)
  endif
  |User|
  if (Add a color?) then (yes)
    :Type in "Color To Add",
    click "Add Color";
    |Browser (code.js)|
    :addColor(): POST {color, userId}
    to /api/AddColor.php;
    |Server (PHP + MySQL)|
    :INSERT INTO Colors (UserId, Name);
    :Return {error:""};
    |Browser (code.js)|
    :Show "Color has been added"
    (response is not checked);
  else (no)
  endif
  |User|
endwhile (yes)
|Browser (code.js)|
:doLogout(): reset userId, firstName, lastName
and expire the cookie;
:Redirect to index.html;
stop
@enduml
