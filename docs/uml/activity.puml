@startuml activity
title COLORS Web App - Activity Diagram

|User|
start
:Open index.html;
:Enter username and password;
:Click "Do It";

|Browser (code.js)|
:doLogin(): POST {login, password}
to /api/Login.php;

|Server (PHP + MySQL)|
:SELECT ID, firstName, lastName
FROM Users WHERE Login=? AND Password=?;
if (Matching row found?) then (yes)
  :Return {id, firstName, lastName, error:""};
else (no)
  :Return {id:0, error:"No Records Found"};
endif

|Browser (code.js)|
if (id < 1?) then (yes)
  :Show "User/Password combination incorrect";
  stop
else (no)
  :saveCookie() (expires in 20 min);
  :Redirect to color.html;
endif

:readCookie() on page load;
if (userId found in cookie?) then (no)
  :Redirect to index.html;
  stop
else (yes)
endif

repeat
  |User|
  if (Choose action) then (Search)
    :Enter search text, click "Search Color";
    |Browser (code.js)|
    :searchColor(): POST {search, userId}
    to /api/SearchColors.php;
    |Server (PHP + MySQL)|
    :SELECT Name FROM Colors
    WHERE Name LIKE %search% AND UserID=?;
    if (Any matches?) then (yes)
      :Return {results:[...], error:""};
      |Browser (code.js)|
      :Show "Color(s) has been retrieved";
      :List matching colors in colorList;
    else (no)
      |Server (PHP + MySQL)|
      :Return {error:"No Records Found"}
      (no results field);
      |Browser (code.js)|
      :Show "Color(s) has been retrieved";
      :Reading results.length throws an error,
      so the color list is not updated;
    endif
  else (Add)
    |User|
    :Enter color name, click "Add Color";
    |Browser (code.js)|
    :addColor(): POST {color, userId}
    to /api/AddColor.php;
    |Server (PHP + MySQL)|
    :INSERT INTO Colors (UserId, Name);
    :Return {error:""};
    |Browser (code.js)|
    :Show "Color has been added";
  endif
  |User|
repeat while (Log out?) is (no)
-> yes;
|Browser (code.js)|
:doLogout(): clear user data,
expire cookie;
:Redirect to index.html;
stop
@enduml
